<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Sistem Pemilihan Guru Teladan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-body: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --navy-950: #090E1A;
      --navy-900: #0F172A;
      --navy-800: #1E293B;
      --navy-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-400: #94A3B8;
      --border-color: #E2E8F0;
      --border-strong: #CBD5E1;
      --primary: #2563EB;
      --primary-hover: #1D4ED8;
      --primary-soft: #EFF6FF;
      --emerald: #059669;
      --emerald-hover: #047857;
      --emerald-soft: #ECFDF5;
      --amber: #D97706;
      --amber-soft: #FFFBEB;
      --danger: #DC2626;
      --danger-hover: #B91C1C;
      --danger-soft: #FEF2F2;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.05);
      --shadow-sm: 0 2px 8px -2px rgba(15, 23, 42, 0.07), 0 1px 3px -1px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 4px 10px -3px rgba(15, 23, 42, 0.04);
      --transition: all 0.2s ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-body);
      color: var(--navy-900);
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Micro-interactions & Focus Ring */
    button, input, select, textarea, .interactive-card {
      font-family: inherit;
      transition: var(--transition);
    }

    button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
      border-color: var(--primary);
    }

    .hidden {
      display: none !important;
    }

    /* ==========================================================================
       BUTTONS & BADGES
       ========================================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      font-size: 0.875rem;
      font-weight: 600;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      user-select: none;
    }

    .btn:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .btn:active:not(:disabled) {
      transform: translateY(0);
    }

    .btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
    }
    .btn-primary:hover:not(:disabled) {
      background-color: var(--primary-hover);
    }

    .btn-navy {
      background-color: var(--navy-900);
      color: #FFFFFF;
    }
    .btn-navy:hover:not(:disabled) {
      background-color: var(--navy-800);
    }

    .btn-emerald {
      background-color: var(--emerald);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
    }
    .btn-emerald:hover:not(:disabled) {
      background-color: var(--emerald-hover);
    }

    .btn-outline {
      background-color: var(--bg-surface);
      color: var(--navy-800);
      border-color: var(--border-strong);
    }
    .btn-outline:hover:not(:disabled) {
      background-color: var(--bg-subtle);
      border-color: var(--slate-400);
    }

    .btn-danger-soft {
      background-color: var(--danger-soft);
      color: var(--danger);
      border-color: #FECACA;
    }
    .btn-danger-soft:hover:not(:disabled) {
      background-color: var(--danger);
      color: #FFFFFF;
    }

    .btn-sm {
      padding: 6px 11px;
      font-size: 0.78rem;
      border-radius: 6px;
      gap: 5px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      font-size: 0.72rem;
      font-weight: 700;
      border-radius: 999px;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
    .badge-emerald {
      background-color: var(--emerald-soft);
      color: var(--emerald);
      border: 1px solid #A7F3D0;
    }
    .badge-amber {
      background-color: var(--amber-soft);
      color: var(--amber);
      border: 1px solid #FDE68A;
    }
    .badge-primary {
      background-color: var(--primary-soft);
      color: var(--primary);
      border: 1px solid #BFDBFE;
    }
    .badge-slate {
      background-color: var(--bg-subtle);
      color: var(--slate-600);
      border: 1px solid var(--border-color);
    }
    .badge-danger {
      background-color: var(--danger-soft);
      color: var(--danger);
      border: 1px solid #FECACA;
    }

    /* ==========================================================================
       LOGIN VIEW
       ========================================================================== */
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: radial-gradient(circle at top right, #EFF6FF 0%, #F8FAFC 50%, #F1F5F9 100%);
    }

    .login-card {
      width: 100%;
      max-width: 430px;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      padding: 32px 28px;
    }

    .brand-seal {
      width: 68px;
      height: 68px;
      border-radius: 16px;
      background-color: var(--navy-900);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px auto;
      box-shadow: 0 6px 14px rgba(15, 23, 42, 0.18);
      overflow: hidden;
    }

    .brand-seal.has-logo {
      width: 108px;
      height: 108px;
      background-color: transparent;
      border: none;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
      margin: 0 auto 14px auto;
      overflow: visible;
    }

    .brand-seal img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--navy-800);
      margin-bottom: 6px;
    }

    .form-control {
      width: 100%;
      padding: 10px 13px;
      font-size: 0.875rem;
      color: var(--navy-900);
      background-color: var(--bg-surface);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
    }

    .form-control:hover {
      border-color: var(--slate-400);
    }

    .password-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .password-input-wrap .form-control {
      padding-right: 42px;
    }
    .password-toggle-btn {
      position: absolute;
      right: 8px;
      background: none;
      border: none;
      color: var(--slate-500);
      padding: 6px;
      cursor: pointer;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .password-toggle-btn:hover {
      color: var(--navy-900);
      background-color: var(--bg-subtle);
    }

    /* ==========================================================================
       NAVBAR & SMART OVERFLOW DRAWER (MOBILE FRIENDLY)
       ========================================================================== */
    .top-navbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background-color: var(--navy-900);
      color: #FFFFFF;
      border-bottom: 1px solid var(--navy-800);
      box-shadow: var(--shadow-sm);
    }

    .navbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .nav-brand-icon {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      background-color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .nav-brand-text h1 {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.2;
      color: #FFFFFF;
    }

    .nav-brand-text p {
      font-size: 0.72rem;
      color: var(--slate-400);
    }

    .nav-links-desktop {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-tab-btn {
      background: transparent;
      color: #CBD5E1;
      border: 1px solid transparent;
      padding: 8px 13px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      cursor: pointer;
    }

    .nav-tab-btn:hover {
      color: #FFFFFF;
      background-color: rgba(255, 255, 255, 0.07);
    }

    .nav-tab-btn.active {
      background-color: var(--primary);
      color: #FFFFFF;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-nav-icon {
      background-color: rgba(255, 255, 255, 0.08);
      color: #E2E8F0;
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 7px 11px;
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
    .btn-nav-icon:hover {
      background-color: rgba(255, 255, 255, 0.16);
      color: #FFFFFF;
    }

    .mobile-more-btn {
      display: none;
    }

    /* Mobile Overflow Menu Dropdown */
    .mobile-drawer {
      background-color: var(--navy-800);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 12px 16px;
    }
    .mobile-drawer-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    @media (max-width: 860px) {
      .nav-links-desktop .nav-overflow-item {
        display: none;
      }
      .mobile-more-btn {
        display: inline-flex;
      }
    }

    @media (max-width: 560px) {
      .nav-links-desktop {
        display: none;
      }
      .mobile-drawer-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ==========================================================================
       MAIN CONTAINER & GRID 2-3 COLUMNS (ANTI-TUMPUK VERTIKAL)
       ========================================================================== */
    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 16px 88px;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .voter-metrics-grid {
      grid-template-columns: 1.45fr 1fr 1fr;
    }

    @media (max-width: 768px) {
      .metrics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .metrics-grid .metric-card:first-child {
        grid-column: span 2;
      }
    }

    .metric-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 15px 16px;
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 6px;
      min-width: 0;
      overflow: hidden;
    }

    .metric-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-sm);
    }

    .metric-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .metric-label {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--slate-500);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .metric-value {
      font-size: clamp(1.25rem, 2.8vw, 1.65rem);
      font-weight: 800;
      color: var(--navy-900);
      line-height: 1.15;
    }

    .metric-sub {
      font-size: 0.76rem;
      color: var(--slate-600);
    }

    /* ==========================================================================
       PANELS & CARDS
       ========================================================================== */
    .section-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-xs);
      margin-bottom: 20px;
      overflow: hidden;
    }

    .section-header {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background-color: #FFFFFF;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--navy-900);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-subtitle {
      font-size: 0.8rem;
      color: var(--slate-500);
      margin-top: 2px;
    }

    .section-body {
      padding: 18px;
    }

    /* Filter Bar */
    .filter-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
      align-items: center;
    }
    .filter-toolbar .search-box {
      flex: 1 1 220px;
      min-width: 180px;
    }
    .filter-toolbar .filter-select {
      flex: 0 1 170px;
    }

    /* ==========================================================================
       FLUID RESPONSIVE TABLE & BARIS GENDUT RAPIH (ANTI-TEKS KEPOTONG)
       ========================================================================== */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: clamp(0.73rem, 1.8vw, 0.86rem);
    }

    .data-table th {
      background-color: var(--bg-subtle);
      color: var(--navy-800);
      font-weight: 700;
      text-align: left;
      padding: 11px 12px;
      border-bottom: 1px solid var(--border-strong);
      font-size: clamp(0.7rem, 1.6vw, 0.78rem);
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }

    .data-table td {
      padding: 13px 12px;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
      color: var(--navy-900);
      word-break: break-word;
      overflow-wrap: anywhere;
      line-height: 1.45;
    }

    .data-table tbody tr:hover {
      background-color: #F8FAFC;
    }

    .data-table tbody tr:last-child td {
      border-bottom: none;
    }

    .rank-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.84rem;
      background-color: var(--bg-subtle);
      color: var(--navy-800);
      margin: 0 auto;
    }
    .rank-1 {
      background-color: #FEF3C7;
      color: #B45309;
      border: 1px solid #F59E0B;
    }
    .rank-2 {
      background-color: #E2E8F0;
      color: #334155;
      border: 1px solid #94A3B8;
    }
    .rank-3 {
      background-color: #FFEDD5;
      color: #9A3412;
      border: 1px solid #FB923C;
    }

    /* Progress Bar */
    .score-bar-track {
      width: 100%;
      height: 7px;
      background-color: var(--bg-subtle);
      border-radius: 999px;
      overflow: hidden;
      margin-top: 6px;
    }
    .score-bar-fill {
      height: 100%;
      background-color: var(--primary);
      border-radius: 999px;
    }

    /* Pagination Bar */
    .pagination-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 14px;
      font-size: 0.8rem;
      color: var(--slate-600);
    }

    /* ==========================================================================
       CATEGORY WINNERS GRID
       ========================================================================== */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 14px;
    }

    .category-winner-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
    }

    .category-winner-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-sm);
    }

    /* ==========================================================================
       VOTER BALLOT INTERFACE (KHUSUS GURU & KEPALA SEKOLAH)
       ========================================================================== */
    .question-ballot-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: var(--shadow-xs);
    }

    .question-ballot-card.answered {
      border-color: #93C5FD;
      background-color: #FCFDFE;
    }

    .candidates-choice-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    .candidate-option-card {
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 13px 15px;
      background-color: var(--bg-surface);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 13px;
      text-align: left;
      width: 100%;
      min-width: 0;
    }

    .candidate-option-card:hover {
      border-color: var(--primary);
      background-color: #F8FAFC;
    }

    .candidate-option-card.selected {
      border-color: var(--primary);
      background-color: var(--primary-soft);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
    }

    .radio-indicator {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid var(--slate-400);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background-color: #FFFFFF;
    }

    .candidate-option-card.selected .radio-indicator {
      border-color: var(--primary);
      background-color: var(--primary);
    }

    .candidate-option-card.selected .radio-indicator::after {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #FFFFFF;
    }

    .sticky-ballot-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 35;
      background-color: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(8px);
      border-top: 1px solid var(--border-strong);
      box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.08);
      padding: 12px 16px;
    }

    .sticky-ballot-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .sticky-nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .question-step-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      padding: 4px 2px 8px 2px;
      margin-bottom: 12px;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    .question-step-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-width: 42px;
      height: 36px;
      padding: 0 11px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      border: 1.5px solid var(--border-strong);
      background-color: var(--bg-surface);
      color: var(--slate-600);
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .question-step-pill:hover {
      border-color: var(--primary);
      color: var(--navy-900);
    }

    .question-step-pill.answered {
      background-color: var(--emerald-soft);
      border-color: #6EE7B7;
      color: var(--emerald);
    }

    .question-step-pill.active {
      background-color: var(--primary);
      border-color: var(--primary);
      color: #FFFFFF;
      box-shadow: 0 3px 10px rgba(37, 99, 235, 0.22);
    }

    /* Interactive Photo Cropper Modal */
    .crop-stage-wrap {
      width: 260px;
      height: 260px;
      margin: 0 auto;
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      background-color: #0F172A;
      border: 2px solid var(--border-strong);
      touch-action: none;
      cursor: grab;
      user-select: none;
    }

    .crop-stage-wrap:active {
      cursor: grabbing;
    }

    .crop-circle-guide {
      position: absolute;
      inset: 14px;
      border-radius: 50%;
      border: 2px dashed rgba(255, 255, 255, 0.9);
      box-shadow: 0 0 0 999px rgba(15, 23, 42, 0.48);
      pointer-events: none;
    }

    .crop-controls-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 14px;
    }

    @media (max-width: 640px) {
      .main-container {
        padding: 14px 12px 136px 12px;
      }
