      var selectedCandId = appState.voterBallot.selectedByQuestion[q.id] || '';
      var isAnsweredClass = selectedCandId ? ' answered' : '';

      html +=
        '<div class="question-ballot-card' + isAnsweredClass + '" id="qCard_' + escapeHtml(q.id) + '">' +
          '<div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px;">' +
            '<div style="display:flex; align-items:center; gap:8px;">' +
              '<span class="badge badge-primary">Soal ' + (curIdx + 1) + ' dari ' + questions.length + '</span>' +
              '<span class="badge badge-slate">' + escapeHtml(q.kategori) + '</span>' +
