    function handlePrintUserCredentials() {
      callBackend('getAllUserCredentialsForPrint', null, function(res) {
        if (!res || !res.success) {
          showToast('Gagal mengambil daftar akun untuk dicetak.', 'error');
          return;
        }
        var items = res.items || [];
        var s = res.settings || appState.settings;

        var bodyHtml =
          '<div class="print-header">' +
            '<h2>' + escapeHtml(s.NAMA_SEKOLAH || 'SEKOLAH') + '</h2>' +
            '<h3>DAFTAR KARTU AKUN LOGIN PEMILIHAN GURU TELADAN</h3>' +
            '<p>Periode: ' + escapeHtml(s.PERIODE_PEMILIHAN || '-') + ' (Potong dan bagikan kepada masing-masing Guru/Kepala Sekolah)</p>' +
          '</div>' +
          '<div class="cred-cards-container">';

        for (var i = 0; i < items.length; i += 2) {
          bodyHtml += '<div class="cred-print-row">';
          for (var j = i; j < i + 2 && j < items.length; j++) {
            var u = items[j];
