  <!-- ROOT APLIKASI -->
  <div id="appRoot">
    <!-- ========================================================================
         1. VIEW LOGIN (ADMIN, GURU, KEPALA SEKOLAH)
         ======================================================================== -->
    <section id="loginView" class="login-wrapper">
      <div class="login-card">
        <div style="text-align: center; margin-bottom: 24px;">
          <!-- __SSR_BRAND_SEAL_START__ -->
          <div id="loginBrandSeal" class="brand-seal">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
          <!-- __SSR_BRAND_SEAL_END__ -->

          <div style="display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
            <span id="loginPeriodBadge" class="badge badge-primary">Tahun Ajaran 2026/2027</span>
