    function buildPrintTopMetaHtml() {
      var now = new Date();
      var timeStampStr = now.toLocaleString('en-US', {
        month: 'numeric',
        day: 'numeric',
        year: '2-digit',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true
      });
      return (
        '<div class="print-top-meta">' +
          '<span>' + escapeHtml(timeStampStr) + '</span>' +
          '<span>Sistem Pemilihan Guru Teladan</span>' +
