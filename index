    function resolveKetuaPanitiaNip(ketuaNameInput, explicitNipInput) {
      var explicitNip = String(explicitNipInput || '').trim();
      if (explicitNip) {
        return explicitNip.replace(/^NIP\.?\s*/i, '').trim();
      }
      var targetKetua = String(ketuaNameInput || '').trim().toLowerCase();
      if (!targetKetua) return '';
      var targetKetuaBase = targetKetua.split(',')[0].trim();

      // Cari dari daftar kandidat/guru yang ada di cache dashboard atau usersById
      var pool = [];
      if (appCache.dashboard && appCache.dashboard.overallStandings) {
        pool = pool.concat(appCache.dashboard.overallStandings);
      }
      for (var uid in appCache.usersById) {
        if (Object.prototype.hasOwnProperty.call(appCache.usersById, uid)) {
          pool.push(appCache.usersById[uid]);
        }
      }

      for (var i = 0; i < pool.length; i++) {
        var item = pool[i];
        if (!item) continue;
        var uNama = String(item.nama || '').trim().toLowerCase();
        var uNamaBase = uNama.split(',')[0].trim();
        var uUser = String(item.username || '').trim().toLowerCase();
        if (
          uNama === targetKetua ||
          (targetKetuaBase && uNamaBase === targetKetuaBase) ||
          (targetKetuaBase && uUser === targetKetuaBase)
        ) {
          var rawJab = String(item.jabatan || '').trim();
          var cleaned = rawJab.replace(/^NIP\.?\s*/i, '').trim();
          if (cleaned && cleaned !== '-') {
            return cleaned;
          }
        }
      }
      return '';
    }

