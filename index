            '<td><strong>' + escapeHtml(cw.kategori) + '</strong><br/><span style="font-size:9pt;">' + escapeHtml(cw.pertanyaan) + '</span></td>' +
            '<td>' + (cw.topWinner ? '<strong>' + escapeHtml(cw.topWinner.nama) + '</strong>' : 'Belum ada suara') + '</td>' +
            '<td>' + (cw.topWinner ? cw.topWinner.points + ' Suara (' + cw.topWinner.percentage + '%)' : '0 Suara') + '</td>' +
