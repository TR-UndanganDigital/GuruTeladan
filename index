          '<p style="font-size:0.78rem; color:var(--slate-500);">' +
            'Klik salah satu nama guru di bawah ini yang menurut Anda paling tepat untuk kriteria <strong>' + escapeHtml(q.kategori) + '</strong>:' +
          '</p>' +
          '<div class="candidates-choice-grid">';

      for (var c = 0; c < candidates.length; c++) {
        var cand = candidates[c];
        // Double protection di sisi klien: pastikan tidak merender nama sendiri
        if (cand.id === u.id) continue;
        var selClass = (selectedCandId === cand.id) ? ' selected' : '';

        html +=
          '<button type="button" class="candidate-option-card' + selClass + '" ' +
            'data-action="select-ballot-candidate" ' +
            'data-question-id="' + escapeHtml(q.id) + '" ' +
            'data-candidate-id="' + escapeHtml(cand.id) + '">' +
            '<span class="radio-indicator"></span>' +
            renderTeacherAvatarHtml(cand.nama, cand.foto, 72) +
            '<span style="display:block; min-width:0; flex:1;">' +
              '<strong style="display:block; font-size:0.93rem; font-weight:700; color:var(--navy-900); line-height:1.3; word-break:break-word;">' + escapeHtml(cand.nama) + '</strong>' +
              '<span style="display:block; font-size:0.76rem; color:var(--slate-500); margin-top:3px; line-height:1.35; word-break:break-word; overflow-wrap:anywhere;">' + escapeHtml(cand.jabatan || 'Kandidat Guru') + '</span>' +
