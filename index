    function switchAdminTab(tabName) {
      appState.activeAdminTab = tabName;
      saveActiveUserSession();

      // Update tombol navigasi aktif
      var navBtns = document.querySelectorAll('[data-action="switch-admin-tab"]');
      for (var i = 0; i < navBtns.length; i++) {
        var b = navBtns[i];
        if (b.getAttribute('data-tab') === tabName) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      }

      // Sembunyikan drawer mobile jika terbuka
      document.getElementById('mobileNavDrawer').classList.add('hidden');

      // Tampilkan pane yang sesuai
      var panes = {
        dashboard: document.getElementById('adminTabDashboard'),
        users: document.getElementById('adminTabUsers'),
        questions: document.getElementById('adminTabQuestions'),
        settings: document.getElementById('adminTabSettings')
      };

      for (var k in panes) {
        if (Object.prototype.hasOwnProperty.call(panes, k) && panes[k]) {
          if (k === tabName) {
            panes[k].classList.remove('hidden');
          } else {
            panes[k].classList.add('hidden');
          }
        }
      }

      // Muat selalu ringkasan metrik atas dari cache jika sudah ada
      if (!appCache.dashboard) {
        loadAdminDashboardData(false);
      } else {
        renderAdminDashboardFromCache();
      }

      if (tabName === 'users') {
        loadUsersPage(appState.userFilter.page, false);
      } else if (tabName === 'questions') {
        loadQuestionsPage(appState.questionFilter.page, false);
      } else if (tabName === 'settings') {
        populateSettingsForm();
      }
    }

