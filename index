              '<div class="cred-print-card">' +
                '<div style="font-weight:800; border-bottom:1px solid #000; padding-bottom:4px; margin-bottom:6px;">' +
                  'KARTU LOGIN PEMILIHAN GURU TELADAN - ' + escapeHtml(s.NAMA_SEKOLAH) +
                '</div>' +
                '<div><strong>Nama:</strong> ' + escapeHtml(u.nama) + '</div>' +
                '<div><strong>Jabatan:</strong> ' + escapeHtml(u.jabatan || u.peran) + '</div>' +
                '<div style="margin-top:6px; padding:6px; border:1px dashed #000; background:#F8FAFC;">' +
                  '<div><strong>Username:</strong> ' + escapeHtml(u.username) + '</div>' +
                  '<div><strong>Password:</strong> ' + escapeHtml(u.password) + '</div>' +
                '</div>' +
                '<div style="font-size:8pt; margin-top:4px;">*Gunakan akun ini untuk memilih 1 kandidat per kriteria.</div>' +
              '</div>';
          }
          bodyHtml += '</div>';
        }

        bodyHtml += '</div>';
        document.getElementById('printArea').innerHTML = wrapWithPrintMasterSheet(bodyHtml);
        executeCleanPrint();
      });
    }

    /**
     * ========================================================================
     * SAFE DYNAMIC EVENT DELEGATION (ANTI-SYNTAX ERROR ON DYNAMIC DOM)
     * ========================================================================
     */
    function setupGlobalEventDelegation() {
      document.addEventListener('click', function(e) {
        var target = e.target.closest('[data-action]');
        if (!target) return;

        var action = target.getAttribute('data-action');
        var id = target.getAttribute('data-id');

        switch (action) {
          case 'toggle-login-pass': {
            var passInput = document.getElementById('loginPassword');
            passInput.type = passInput.type === 'password' ? 'text' : 'password';
            break;
          }
          case 'logout':
            handleLogout();
            break;
          case 'refresh-voter-ballot':
            refreshVoterBallotData();
            break;
          case 'select-ballot-candidate': {
            var qId = target.getAttribute('data-question-id');
            var cId = target.getAttribute('data-candidate-id');
            handleSelectBallotCandidate(qId, cId);
            break;
          }
          case 'prev-ballot-question': {
            var curPrev = parseInt(appState.voterBallot.currentQuestionIndex, 10) || 0;
            gotoBallotQuestion(curPrev - 1);
            break;
          }
          case 'next-ballot-question': {
            var curNext = parseInt(appState.voterBallot.currentQuestionIndex, 10) || 0;
            gotoBallotQuestion(curNext + 1);
            break;
          }
          case 'goto-ballot-question': {
            var gotoIdx = parseInt(target.getAttribute('data-index'), 10);
            if (!isNaN(gotoIdx)) {
              gotoBallotQuestion(gotoIdx);
            }
            break;
          }
          case 'confirm-submit-ballot':
            handleConfirmSubmitBallot();
            break;
          case 'switch-admin-tab': {
            var tab = target.getAttribute('data-tab');
            switchAdminTab(tab);
            break;
          }
          case 'toggle-mobile-drawer': {
            var drawer = document.getElementById('mobileNavDrawer');
            drawer.classList.toggle('hidden');
            break;
          }
          case 'refresh-admin-data':
            refreshAllAdminData();
            break;
          case 'quick-toggle-election':
            handleQuickToggleElection();
            break;
          case 'print-berita-acara':
            handlePrintBeritaAcara();
            break;
          case 'print-user-credentials':
            handlePrintUserCredentials();
            break;
          case 'sync-27-teachers':
            handleSync27Teachers();
            break;
          case 'sync-10-questions':
            handleSync10Questions();
            break;
          case 'trigger-voter-photo-file': {
            var vPhotoInput = document.getElementById('voterOwnPhotoFile');
            if (vPhotoInput) vPhotoInput.click();
            break;
          }
          case 'trigger-photo-file': {
            var fInput = document.getElementById('userFormPhotoFile');
            if (fInput) fInput.click();
            break;
          }
          case 'close-crop-modal':
            closePhotoCropperModal();
            break;
          case 'crop-zoom-in':
            adjustCropZoom(20);
            break;
          case 'crop-zoom-out':
            adjustCropZoom(-20);
            break;
          case 'crop-reset-pos':
            resetCropPosition();
            break;
          case 'apply-crop-photo':
            handleApplyCroppedPhoto();
            break;
          case 'clear-user-photo': {
            document.getElementById('userFormRawFoto').value = '';
            updateModalPhotoPreview();
            break;
          }
          case 'trigger-logo-file': {
            var logoFileInput = document.getElementById('setLogoFileInput');
            if (logoFileInput) logoFileInput.click();
            break;
          }
          case 'clear-school-logo': {
            var logoEl = document.getElementById('setLogoSekolah');
            if (logoEl) logoEl.value = '';
            appState.pendingLogoDataUri = '';
            updateSettingsLogoPreview();
            break;
          }
          case 'open-add-user-modal':
            openAddUserModal();
            break;
          case 'open-edit-user-modal':
            openEditUserModal(id);
            break;
          case 'close-user-modal':
            document.getElementById('userModal').classList.add('hidden');
            break;
          case 'delete-user':
            handleDeleteUser(id);
            break;
          case 'reset-user-vote':
            handleResetUserVote(id);
            break;
          case 'page-users': {
            var pUser = parseInt(target.getAttribute('data-page'), 10) || 1;
            loadUsersPage(pUser, false);
            break;
          }
          case 'open-add-question-modal':
            openAddQuestionModal();
            break;
          case 'open-edit-question-modal':
            openEditQuestionModal(id);
            break;
          case 'close-question-modal':
            document.getElementById('questionModal').classList.add('hidden');
            break;
          case 'delete-question':
            handleDeleteQuestion(id);
            break;
          case 'page-questions': {
            var pQuest = parseInt(target.getAttribute('data-page'), 10) || 1;
            loadQuestionsPage(pQuest, false);
            break;
          }
          case 'confirm-reset-all-votes':
            handleConfirmResetAllVotes();
            break;
          case 'close-confirm-modal':
            closeConfirmModal();
            break;
          case 'close-api-config-modal':
            closeApiConfigModal();
            break;
          case 'open-api-config-modal':
            openApiConfigModal();
            break;
          case 'execute-confirm-callback': {
            var cb = appState.confirmCallback;
            closeConfirmModal();
            if (typeof cb === 'function') cb();
            break;
          }
        }
      });
    }
