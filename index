    /**
     * ========================================================================
     * INTERACTIVE IMAGE CROPPER (UNTUK AKUN ADMIN & AKUN PEMILIH)
     * ========================================================================
     */
    var cropState = {
      img: null,
      baseScale: 1,
      zoomPercent: 100,
      offsetX: 0,
      offsetY: 0,
      isDragging: false,
      startX: 0,
      startY: 0,
      startOffsetX: 0,
      startOffsetY: 0,
      listenersBound: false,
      onConfirm: null
    };

    function initCropDragListeners() {
      if (cropState.listenersBound) return;
      var stage = document.getElementById('cropStageWrap');
      if (!stage) return;
      cropState.listenersBound = true;

      function startDrag(clientX, clientY) {
        if (!cropState.img) return;
        cropState.isDragging = true;
        cropState.startX = clientX;
        cropState.startY = clientY;
        cropState.startOffsetX = cropState.offsetX;
        cropState.startOffsetY = cropState.offsetY;
      }

      function moveDrag(clientX, clientY) {
        if (!cropState.isDragging || !cropState.img) return;
        var stageRect = stage.getBoundingClientRect();
        var ratio = stageRect.width > 0 ? (320 / stageRect.width) : 1;
        var dx = (clientX - cropState.startX) * ratio;
        var dy = (clientY - cropState.startY) * ratio;
        cropState.offsetX = cropState.startOffsetX + dx;
        cropState.offsetY = cropState.startOffsetY + dy;
        clampCropOffsets();
        renderCropCanvas();
      }

      function endDrag() {
        cropState.isDragging = false;
      }

      stage.addEventListener('mousedown', function(e) {
        e.preventDefault();
        startDrag(e.clientX, e.clientY);
      });
      window.addEventListener('mousemove', function(e) {
        if (cropState.isDragging) {
          e.preventDefault();
          moveDrag(e.clientX, e.clientY);
        }
      });
      window.addEventListener('mouseup', endDrag);

      stage.addEventListener('touchstart', function(e) {
        if (e.touches && e.touches.length === 1) {
          e.preventDefault();
          startDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });
      stage.addEventListener('touchmove', function(e) {
        if (cropState.isDragging && e.touches && e.touches.length === 1) {
          e.preventDefault();
          moveDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });
      stage.addEventListener('touchend', endDrag);
      stage.addEventListener('touchcancel', endDrag);
    }

    function clampCropOffsets() {
      if (!cropState.img) return;
      var canvasSize = 320;
      var scale = cropState.baseScale * (cropState.zoomPercent / 100);
      var drawW = cropState.img.width * scale;
      var drawH = cropState.img.height * scale;
      var maxOffX = Math.max(0, (drawW - canvasSize) / 2);
      var maxOffY = Math.max(0, (drawH - canvasSize) / 2);

      if (cropState.offsetX > maxOffX) cropState.offsetX = maxOffX;
      if (cropState.offsetX < -maxOffX) cropState.offsetX = -maxOffX;
      if (cropState.offsetY > maxOffY) cropState.offsetY = maxOffY;
      if (cropState.offsetY < -maxOffY) cropState.offsetY = -maxOffY;
    }

    function renderCropCanvas() {
      var canvas = document.getElementById('cropCanvas');
      if (!canvas || !cropState.img) return;
      var ctx = canvas.getContext('2d');
      var size = canvas.width;
      ctx.clearRect(0, 0, size, size);
      ctx.fillStyle = '#0F172A';
      ctx.fillRect(0, 0, size, size);

      var scale = cropState.baseScale * (cropState.zoomPercent / 100);
      var drawW = cropState.img.width * scale;
      var drawH = cropState.img.height * scale;
      var x = ((size - drawW) / 2) + cropState.offsetX;
      var y = ((size - drawH) / 2) + cropState.offsetY;

      ctx.drawImage(cropState.img, x, y, drawW, drawH);
    }

    function openPhotoCropperModal(file, onConfirmCallback) {
      if (!file) return;
      if (file.size > 6 * 1024 * 1024) {
        showToast('Ukuran foto terlalu besar (Maksimal 6 MB).', 'error');
        return;
      }

      initCropDragListeners();
      var reader = new FileReader();
      reader.onload = function(evt) {
        var img = new Image();
        img.onload = function() {
          cropState.img = img;
          var w = img.width || 320;
          var h = img.height || 320;
          cropState.baseScale = Math.max(320 / w, 320 / h);
          cropState.zoomPercent = 100;
          cropState.offsetX = 0;
          cropState.offsetY = 0;
          cropState.onConfirm = onConfirmCallback;

          var slider = document.getElementById('cropZoomSlider');
          if (slider) slider.value = '100';

          renderCropCanvas();
          document.getElementById('photoCropModal').classList.remove('hidden');
        };
        img.onerror = function() {
          showToast('File gambar tidak dapat dibaca.', 'error');
        };
        img.src = String(evt.target.result || '');
      };
      reader.readAsDataURL(file);
    }

    function handleCropZoomChange(val) {
      var z = parseInt(val, 10) || 100;
      if (z < 100) z = 100;
      if (z > 300) z = 300;
      cropState.zoomPercent = z;
      var slider = document.getElementById('cropZoomSlider');
      if (slider && String(slider.value) !== String(z)) {
        slider.value = String(z);
      }
      clampCropOffsets();
      renderCropCanvas();
    }

    function adjustCropZoom(delta) {
      handleCropZoomChange((cropState.zoomPercent || 100) + delta);
    }

    function resetCropPosition() {
      cropState.zoomPercent = 100;
      cropState.offsetX = 0;
      cropState.offsetY = 0;
      var slider = document.getElementById('cropZoomSlider');
      if (slider) slider.value = '100';
      renderCropCanvas();
    }

    function closePhotoCropperModal() {
      document.getElementById('photoCropModal').classList.add('hidden');
      cropState.img = null;
      cropState.onConfirm = null;
    }

    function handleApplyCroppedPhoto() {
      if (!cropState.img || typeof cropState.onConfirm !== 'function') {
        closePhotoCropperModal();
        return;
      }

      var outSize = 400;
      var ratio = outSize / 320;
      var outCanvas = document.createElement('canvas');
      outCanvas.width = outSize;
      outCanvas.height = outSize;
      var outCtx = outCanvas.getContext('2d');
      outCtx.fillStyle = '#FFFFFF';
      outCtx.fillRect(0, 0, outSize, outSize);

      var scale = cropState.baseScale * (cropState.zoomPercent / 100) * ratio;
      var drawW = cropState.img.width * scale;
      var drawH = cropState.img.height * scale;
      var x = ((outSize - drawW) / 2) + (cropState.offsetX * ratio);
      var y = ((outSize - drawH) / 2) + (cropState.offsetY * ratio);

      outCtx.drawImage(cropState.img, x, y, drawW, drawH);

      var dataUrl = outCanvas.toDataURL('image/jpeg', 0.90);
      var commaIdx = dataUrl.indexOf(',');
      var base64Data = commaIdx !== -1 ? dataUrl.substring(commaIdx + 1) : dataUrl;

      var cb = cropState.onConfirm;
      closePhotoCropperModal();
      cb(base64Data, dataUrl);
    }

