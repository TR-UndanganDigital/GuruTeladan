    /**
     * ========================================================================
     * AUTENTIKASI LOGIN & LOGOUT
     * ========================================================================
     */
    function handleLoginSubmit() {
      var uInput = document.getElementById('loginUsername');
      var pInput = document.getElementById('loginPassword');
      var btn = document.getElementById('btnLoginSubmit');

      var payload = {
        username: String(uInput.value || '').trim(),
        password: String(pInput.value || '').trim()
      };

      if (!payload.username || !payload.password) {
        showToast('Mohon isi Username dan Password terlebih dahulu.', 'error');
        return;
      }

      callBackend('authenticateUser', payload, function(res) {
        if (!res || !res.success) {
          showToast((res && res.message) ? res.message : 'Login gagal.', 'error');
          return;
        }

        appState.currentUser = res.user;
        if (res.settings) {
          appState.settings = res.settings;
          saveSettingsToLocalCache(appState.settings);
        }

        pInput.value = '';
        showToast(res.message || 'Berhasil masuk.', 'success');

        if (appState.currentUser.peran === 'Admin') {
          appState.activeAdminTab = 'dashboard';
          saveActiveUserSession();
          enterAdminView('dashboard');
        } else {
          appState.voterBallot.selectedByQuestion = {};
          appState.voterBallot.currentQuestionIndex = 0;
          enterVoterView(res.ballotBundle);
          saveActiveUserSession();
        }
      }, null, btn);
    }

    function handleLogout() {
      appState.currentUser = null;
      appState.voterBallot.selectedByQuestion = {};
      appState.voterBallot.currentQuestionIndex = 0;
      clearActiveUserSession();
      invalidateCache(['ALL']);

      document.getElementById('adminView').classList.add('hidden');
      document.getElementById('voterView').classList.add('hidden');
      document.getElementById('voterStickyFooter').classList.add('hidden');
      document.getElementById('loginView').classList.remove('hidden');
      renderLoginHeaderInfo();
    }

