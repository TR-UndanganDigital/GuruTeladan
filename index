            Pemilihan Guru Teladan
          </h1>
          <p id="loginSchoolName" style="font-size: 0.9rem; color: var(--slate-600); font-weight: 600; margin-top: 3px; text-align: center;">
            UPTD SDN 6 WAY RATAI
          </p>
        </div>
        <script>
          // Eksekusi Sinkron 0.00 Detik (Sebelum Browser Melakukan Paint Pertama)
          (function() {
            try {
              var initCfg = window.__INITIAL_SETTINGS__ || null;
              if (!initCfg) {
                var savedJson = localStorage.getItem('sipegut_settings_v13');
                if (savedJson) initCfg = JSON.parse(savedJson);
              } else {
                try { localStorage.setItem('sipegut_settings_v13', JSON.stringify(initCfg)); } catch (eStorage) {}
              }
              if (!initCfg) return;

              var sNameEl = document.getElementById('loginSchoolName');
              if (sNameEl && initCfg.NAMA_SEKOLAH) sNameEl.textContent = initCfg.NAMA_SEKOLAH;

              var pBadgeEl = document.getElementById('loginPeriodBadge');
              if (pBadgeEl && initCfg.PERIODE_PEMILIHAN) pBadgeEl.textContent = initCfg.PERIODE_PEMILIHAN;

              var stBadgeEl = document.getElementById('loginStatusBadge');
              if (stBadgeEl && initCfg.STATUS_PEMILIHAN) {
                var openNow = String(initCfg.STATUS_PEMILIHAN).toUpperCase() === 'BUKA';
                stBadgeEl.textContent = openNow ? 'KOTAK SUARA: BUKA' : 'KOTAK SUARA: TUTUP';
                stBadgeEl.className = openNow ? 'badge badge-emerald' : 'badge badge-danger';
              }

              var rawLogo = String(initCfg.LOGO_SEKOLAH_URL || initCfg.LOGO_SEKOLAH || '').trim();
              var sealEl = document.getElementById('loginBrandSeal');
              if (sealEl && rawLogo) {
                var existingImg = sealEl.querySelector('img');
                if (!existingImg || existingImg.getAttribute('src') !== rawLogo) {
                  sealEl.classList.add('has-logo');
                  sealEl.innerHTML = '';
                  var im = document.createElement('img');
                  im.src = rawLogo;
                  im.alt = 'Logo Sekolah';
                  im.decoding = 'sync';
                  im.style.width = '100%';
                  im.style.height = '100%';
                  im.style.objectFit = 'contain';
                  sealEl.appendChild(im);
                }
              }

              // Sembunyikan #loginView seketika (0.00s) jika sesi login aktif (< 20 menit) masih berlaku
              var sessRaw = localStorage.getItem('sipegut_active_session_v14');
              if (sessRaw) {
                var sessObj = JSON.parse(sessRaw);
                if (sessObj && sessObj.user && sessObj.expiresAt && new Date().getTime() < sessObj.expiresAt) {
                  var lv = document.getElementById('loginView');
                  if (lv) lv.classList.add('hidden');
                }
              }
            } catch (errSync) {}
          })();
        </script>

