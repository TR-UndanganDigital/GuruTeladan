    /**
     * Membungkus konten cetak dengan Master Print Frame (<table class="print-master-sheet">)
     * agar thead (margin atas + waktu & judul rata kiri) serta tfoot (margin bawah)
     * otomatis berulang di Lembar ke-1, Lembar ke-2, dan seterusnya.
     */
    function wrapWithPrintMasterSheet(innerBodyHtml) {
      return (
        '<table class="print-master-sheet">' +
          '<thead class="print-running-header">' +
            '<tr>' +
              '<td>' +
                '<div class="print-running-header-space">' +
                  buildPrintTopMetaHtml() +
                '</div>' +
              '</td>' +
            '</tr>' +
          '</thead>' +
          '<tbody>' +
            '<tr>' +
              '<td>' +
                innerBodyHtml +
              '</td>' +
            '</tr>' +
          '</tbody>' +
          '<tfoot class="print-running-footer">' +
            '<tr>' +
              '<td>' +
                '<div class="print-running-footer-space"></div>' +
              '</td>' +
            '</tr>' +
          '</tfoot>' +
        '</table>'
      );
    }

    function executeCleanPrint() {
      var prevTitle = document.title;
      document.title = '';
      window.print();
      setTimeout(function() {
        document.title = prevTitle;
      }, 400);
    }

    function handlePrintBeritaAcara() {
