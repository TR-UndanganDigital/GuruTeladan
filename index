    function enterVoterView(initialBundle) {
      document.getElementById('loginView').classList.add('hidden');
      document.getElementById('adminView').classList.add('hidden');
      document.getElementById('voterView').classList.remove('hidden');

      var s = appState.settings;
      document.getElementById('voterHeaderSchool').textContent = s.NAMA_SEKOLAH || 'Pemilihan Guru Teladan';
      renderVoterProfileCard();
      renderSchoolLogoBranding();

      if (initialBundle) {
        appState.voterBallot.questions = initialBundle.questions || [];
        appState.voterBallot.candidates = initialBundle.candidates || [];
        if (!initialBundle.preserveSelections) {
          appState.voterBallot.selectedByQuestion = {};
          appState.voterBallot.currentQuestionIndex = 0;
        }
        saveActiveUserSession();
        renderVoterBallotScreen();
      } else {
        refreshVoterBallotData();
      }
    }

    function refreshVoterBallotData() {
      if (!appState.currentUser) return;
      callBackend('getVoterBallotData', appState.currentUser.id, function(res) {
        if (res && res.success) {
          appState.currentUser = res.user;
          appState.settings = res.settings || appState.settings;
          appState.voterBallot.questions = (res.ballotBundle && res.ballotBundle.questions) ? res.ballotBundle.questions : [];
          appState.voterBallot.candidates = (res.ballotBundle && res.ballotBundle.candidates) ? res.ballotBundle.candidates : [];
          renderVoterProfileCard();
          saveActiveUserSession();
          renderVoterBallotScreen();
          showToast('Lembar pemilihan telah diperbarui.', 'success');
        }
      });
    }

    function renderVoterBallotScreen() {
      var u = appState.currentUser;
      var s = appState.settings;
      var container = document.getElementById('voterBallotContainer');
      var stickyFooter = document.getElementById('voterStickyFooter');
      var statusEl = document.getElementById('voterCardStatus');

      var isAlreadyVoted = u.statusPilih === 'Sudah Memilih';
      var isElectionOpen = String(s.STATUS_PEMILIHAN || 'BUKA').toUpperCase() === 'BUKA';

      if (isAlreadyVoted) {
        statusEl.innerHTML = '<span class="badge badge-emerald">SUDAH MEMILIH</span>';
        document.getElementById('voterProgressValue').textContent = 'Selesai';
        stickyFooter.classList.add('hidden');

        container.innerHTML =
          '<div class="section-card">' +
            '<div class="section-body" style="text-align:center; padding: 36px 20px;">' +
              '<div style="width:56px; height:56px; border-radius:50%; background:var(--emerald-soft); color:var(--emerald); display:inline-flex; align-items:center; justify-content:center; margin-bottom:14px;">' +
                '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">' +
                  '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>' +
                  '<polyline points="22 4 12 14.01 9 11.01"></polyline>' +
                '</svg>' +
              '</div>' +
              '<h2 style="font-size:1.2rem; font-weight:800; color:var(--navy-900); margin-bottom:6px;">Terima Kasih, Hak Suara Anda Telah Tercatat!</h2>' +
              '<p style="font-size:0.9rem; color:var(--slate-600); max-width:520px; margin:0 auto 14px;">' +
                'Anda telah menyelesaikan pemilihan Guru Teladan untuk seluruh kategori pertanyaan pada <strong>' + escapeHtml(u.waktuPilih || 'periode ini') + '</strong>.' +
              '</p>' +
              '<span class="badge badge-slate">1 Akun Hanya Dapat Memilih 1 Kali</span>' +
            '</div>' +
          '</div>';
        return;
      }

      if (!isElectionOpen) {
        statusEl.innerHTML = '<span class="badge badge-danger">PERIODE DITUTUP</span>';
        document.getElementById('voterProgressValue').textContent = 'Terkunci';
        stickyFooter.classList.add('hidden');

        container.innerHTML =
          '<div class="section-card">' +
            '<div class="section-body" style="text-align:center; padding: 36px 20px;">' +
              '<h2 style="font-size:1.15rem; font-weight:800; color:var(--navy-900); margin-bottom:6px;">Periode Pemilihan Sedang Ditutup</h2>' +
              '<p style="font-size:0.88rem; color:var(--slate-600); max-width:480px; margin:0 auto;">' +
                'Saat ini kotak suara sedang dikunci oleh Admin Panitia. Silakan hubungi panitia jika Anda belum sempat memberikan suara.' +
              '</p>' +
            '</div>' +
          '</div>';
        return;
      }

      statusEl.innerHTML = '<span class="badge badge-amber">BELUM MEMILIH</span>';

      var questions = appState.voterBallot.questions || [];
      var rawCandidates = appState.voterBallot.candidates || [];
      // Pastikan kandidat selalu diurutkan berdasarkan abjad (A-Z) saat voting
      var candidates = rawCandidates.slice().sort(function(a, b) {
        return String(a.nama || '').localeCompare(String(b.nama || ''), 'id', { sensitivity: 'base' });
      });

      if (questions.length === 0 || candidates.length === 0) {
        stickyFooter.classList.add('hidden');
        container.innerHTML =
          '<div class="section-card"><div class="section-body" style="text-align:center; padding:28px;">' +
            'Belum ada daftar pertanyaan aktif atau kandidat guru yang tersedia.' +
          '</div></div>';
        return;
      }

      stickyFooter.classList.remove('hidden');

      var curIdx = parseInt(appState.voterBallot.currentQuestionIndex, 10) || 0;
      if (curIdx < 0) curIdx = 0;
      if (curIdx >= questions.length) curIdx = questions.length - 1;
      appState.voterBallot.currentQuestionIndex = curIdx;

      var html = '<div class="question-step-bar" id="questionStepBar">';
      for (var sIdx = 0; sIdx < questions.length; sIdx++) {
        var sq = questions[sIdx];
        var sAnswered = Boolean(appState.voterBallot.selectedByQuestion[sq.id]);
