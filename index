          '<h3>BERITA ACARA &amp; LAPORAN REKAPITULASI PEMILIHAN GURU TELADAN</h3>' +
          '<p>Periode: ' + escapeHtml(s.PERIODE_PEMILIHAN || '-') + ' | Tanggal Cetak: ' + escapeHtml(todayStr) + '</p>' +
        '</div>' +
        '<p style="margin-bottom:10px; font-size:10.5pt; text-align:justify;">' +
          'Berdasarkan hasil pemungutan suara pemilihan Guru Teladan secara tertutup dan objektif oleh Dewan Guru dan Kepala Sekolah pada <strong>' + escapeHtml(s.NAMA_SEKOLAH) + '</strong> (' +
          'Total Pemilih Terdaftar: <strong>' + (sum.totalVoters || 0) + '</strong> orang, ' +
          'Suara Masuk: <strong>' + (sum.votedCount || 0) + '</strong> orang / <strong>' + (sum.participationRate || 0) + '%</strong>), diperoleh hasil rekapitulasi sebagai berikut:' +
        '</p>' +
        '<h4 class="print-section-heading">I. KLASEMEN PEROLEHAN POIN JUARA UMUM (AKUMULASI SELURUH KRITERIA)</h4>' +
        '<table class="print-table">' +
          '<thead>' +
            '<tr>' +
              '<th style="width:55px;">Peringkat</th>' +
              '<th>Nama Kandidat Guru</th>' +
              '<th>NIP / Jabatan</th>' +
              '<th style="width:110px;">Total Poin Suara</th>' +
              '<th style="width:90px;">Persentase</th>' +
            '</tr>' +
          '</thead>' +
          '<tbody>';

      for (var i = 0; i < standings.length; i++) {
        var st = standings[i];
        bodyHtml +=
          '<tr>' +
            '<td style="text-align:center; font-weight:bold;">' + st.rank + '</td>' +
            '<td><strong>' + escapeHtml(st.nama) + '</strong></td>' +
            '<td>' + escapeHtml(st.jabatan || '-') + '</td>' +
            '<td style="font-weight:bold;">' + st.totalPoints + ' Poin</td>' +
            '<td>' + st.percentage + '%</td>' +
          '</tr>';
      }

      bodyHtml +=
          '</tbody>' +
        '</table>' +
        '<h4 class="print-section-heading">II. REKAPITULASI TERBAIK PER KATEGORI PERTANYAAN KRITERIA</h4>' +
        '<table class="print-table">' +
          '<thead>' +
            '<tr>' +
              '<th style="width:45px;">No</th>' +
              '<th>Aspek Kriteria</th>' +
              '<th>Guru Peraih Suara Tertinggi</th>' +
              '<th style="width:120px;">Perolehan Suara</th>' +
