    /**
     * Membuat Base64 Data URI ukuran tajam (maks 300x300 px) di sisi klien agar Logo Sekolah
     * berukuran besar (108px) dapat disimpan di CacheService/PropertiesService server dan tampil 0.00 detik.
     */
    function buildCompactLogoDataUri(dataUrl, callback) {
      try {
        var img = new Image();
        img.onload = function() {
          try {
            var maxDim = 300;
            var w = img.width || maxDim;
            var h = img.height || maxDim;
            if (w > maxDim || h > maxDim) {
              if (w >= h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }
            var canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            var ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, w, h);
            ctx.drawImage(img, 0, 0, w, h);
            var compactUri = canvas.toDataURL('image/png');
            callback(compactUri);
          } catch (errC) {
            callback('');
          }
        };
        img.onerror = function() {
          callback('');
        };
        img.src = dataUrl;
      } catch (e) {
        callback('');
      }
    }

    function updateSettingsLogoPreview() {
      var logoInput = document.getElementById('setLogoSekolah');
      var previewWrap = document.getElementById('setLogoPreviewWrap');
      var rawVal = logoInput ? String(logoInput.value || '').trim() : '';
      var previewSrc = (appState.pendingLogoDataUri && rawVal)
        ? appState.pendingLogoDataUri
        : ((rawVal === appState.settings.LOGO_SEKOLAH && appState.settings.LOGO_SEKOLAH_URL) ? appState.settings.LOGO_SEKOLAH_URL : rawVal);
      applyLogoToSealElement(previewWrap, previewSrc, getStarSealSvgHtml(26));
    }

    function handleUploadLogoToDrive(fileInput) {
      if (!fileInput || !fileInput.files || fileInput.files.length === 0) return;
      var file = fileInput.files[0];

      if (file.size > 4 * 1024 * 1024) {
        showToast('Ukuran file logo terlalu besar (Maksimal 4 MB).', 'error');
        fileInput.value = '';
        return;
      }

      var schoolName = document.getElementById('setNamaSekolah').value || 'Logo_Sekolah';
      var triggerBtn = document.getElementById('btnTriggerUploadLogo');
      var reader = new FileReader();

      reader.onload = function(evt) {
        var resultStr = String(evt.target.result || '');
        var commaIndex = resultStr.indexOf(',');
        var base64Data = commaIndex !== -1 ? resultStr.substring(commaIndex + 1) : resultStr;

        buildCompactLogoDataUri(resultStr, function(compactDataUri) {
          if (compactDataUri) {
            appState.pendingLogoDataUri = compactDataUri;
          }

          var payload = {
            base64Data: base64Data,
            mimeType: file.type || 'image/png',
            fileName: file.name || 'logo_sekolah.png',
            teacherName: 'Logo_' + schoolName,
            compactDataUri: compactDataUri || ''
          };

          callBackend('uploadTeacherPhotoToDrive', payload, function(res) {
            fileInput.value = '';
            if (!res || !res.success) {
              showToast((res && res.message) ? res.message : 'Gagal mengunggah logo ke Google Drive.', 'error');
              return;
            }
            if (res.instantDataUri) {
              appState.pendingLogoDataUri = res.instantDataUri;
            }
            document.getElementById('setLogoSekolah').value = res.driveUrl || res.thumbnailUrl || '';
            updateSettingsLogoPreview();
            showToast('Logo sekolah berhasil diunggah ke Google Drive. Klik "Simpan Pengaturan Sistem" untuk menerapkan.', 'success');
          }, function() {
            fileInput.value = '';
          }, triggerBtn);
        });
      };

      reader.readAsDataURL(file);
    }

    function handleSaveSettings() {
      var rawLogo = String(document.getElementById('setLogoSekolah').value || '').trim();
      if (!rawLogo) {
        appState.pendingLogoDataUri = '';
      }
      var ketuaVal = String(document.getElementById('setKetuaPanitia').value || '').trim();
      var nipKetuaEl = document.getElementById('setNipKetuaPanitia');
      var nipKetuaVal = nipKetuaEl ? String(nipKetuaEl.value || '').trim() : '';
      if (!nipKetuaVal && ketuaVal) {
        nipKetuaVal = resolveKetuaPanitiaNip(ketuaVal, '');
      }
      var payload = {
        NAMA_SEKOLAH: String(document.getElementById('setNamaSekolah').value || '').trim(),
        PERIODE_PEMILIHAN: String(document.getElementById('setPeriode').value || '').trim(),
        STATUS_PEMILIHAN: document.getElementById('setStatusPemilihan').value,
        KEPALA_SEKOLAH: String(document.getElementById('setKepalaSekolah').value || '').trim(),
        NIP_KEPSEK: String(document.getElementById('setNipKepsek').value || '').trim(),
        KETUA_PANITIA: ketuaVal,
        NIP_KETUA_PANITIA: nipKetuaVal,
        LOGO_SEKOLAH: rawLogo,
        LOGO_DATA_URI: rawLogo ? (appState.pendingLogoDataUri || '') : ''
      };

      var btn = document.getElementById('btnSaveSettings');
      callBackend('saveSystemSettings', payload, function(res) {
        if (!res || !res.success) {
          showToast((res && res.message) ? res.message : 'Gagal menyimpan pengaturan.', 'error');
          return;
        }
        appState.settings = res.settings || payload;
        if (!appState.settings.LOGO_SEKOLAH_URL) {
          appState.settings.LOGO_SEKOLAH_URL = appState.pendingLogoDataUri || normalizeClientDriveUrl(appState.settings.LOGO_SEKOLAH || '');
        }
        saveSettingsToLocalCache(appState.settings);
        if (appCache.dashboard) {
          appCache.dashboard.settings = appState.settings;
        }
        populateSettingsForm();
        renderAdminDashboardFromCache();
        renderLoginHeaderInfo();
        showToast(res.message, 'success');
      }, null, btn);
    }

    function handleQuickToggleElection() {
      var currentStatus = String(appState.settings.STATUS_PEMILIHAN || 'BUKA').toUpperCase();
      var nextStatus = currentStatus === 'BUKA' ? 'TUTUP' : 'BUKA';

      openConfirmModal(
        nextStatus === 'BUKA' ? 'Buka Kotak Suara Pemilihan?' : 'Tutup / Kunci Kotak Suara Pemilihan?',
        nextStatus === 'BUKA'
          ? 'Guru dan Kepala Sekolah yang belum memilih akan dapat masuk dan memberikan suara.'
          : 'Kotak suara akan dikunci. Guru yang belum memilih tidak dapat mengirim suara sampai dibuka kembali.',
        function() {
          var payload = {
            NAMA_SEKOLAH: appState.settings.NAMA_SEKOLAH,
            PERIODE_PEMILIHAN: appState.settings.PERIODE_PEMILIHAN,
            STATUS_PEMILIHAN: nextStatus,
            KEPALA_SEKOLAH: appState.settings.KEPALA_SEKOLAH,
            NIP_KEPSEK: appState.settings.NIP_KEPSEK,
            KETUA_PANITIA: appState.settings.KETUA_PANITIA,
            NIP_KETUA_PANITIA: appState.settings.NIP_KETUA_PANITIA || '',
            LOGO_SEKOLAH: appState.settings.LOGO_SEKOLAH || ''
          };
          callBackend('saveSystemSettings', payload, function(res) {
            if (res && res.success) {
              appState.settings = res.settings || payload;
              if (appCache.dashboard) appCache.dashboard.settings = appState.settings;
              renderAdminDashboardFromCache();
              populateSettingsForm();
              showToast('Status kotak suara berhasil diubah menjadi: ' + nextStatus, 'success');
            }
          });
        },
        'Ya, Ubah ke ' + nextStatus
      );
    }

