      if (activePillEl && activePillEl.scrollIntoView) {
        try {
          activePillEl.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        } catch (eScroll) {}
      }
    }

    function gotoBallotQuestion(targetIndex) {
      var questions = appState.voterBallot.questions || [];
      if (questions.length === 0) return;
      var nextIdx = parseInt(targetIndex, 10);
      if (isNaN(nextIdx)) return;
      if (nextIdx < 0) nextIdx = 0;
      if (nextIdx >= questions.length) nextIdx = questions.length - 1;
      if (nextIdx === appState.voterBallot.currentQuestionIndex) return;

      appState.voterBallot.currentQuestionIndex = nextIdx;
      saveActiveUserSession();
      renderVoterBallotScreen();

      var cardEl = document.getElementById('voterBallotContainer');
      if (cardEl && cardEl.scrollIntoView) {
        cardEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function handleSelectBallotCandidate(questionId, candidateId) {
      if (!questionId || !candidateId) return;
      if (appState.currentUser && candidateId === appState.currentUser.id) {
        showToast('Anda tidak diperkenankan memilih nama Anda sendiri.', 'error');
        return;
      }

      appState.voterBallot.selectedByQuestion[questionId] = candidateId;
      saveActiveUserSession();

      // Update tampilan kartu pertanyaan tersebut secara instan
      var qCard = document.getElementById('qCard_' + questionId);
      if (qCard) {
        qCard.classList.add('answered');
        var optionBtns = qCard.querySelectorAll('.candidate-option-card');
        for (var i = 0; i < optionBtns.length; i++) {
          var btn = optionBtns[i];
          if (btn.getAttribute('data-candidate-id') === candidateId) {
            btn.classList.add('selected');
          } else {
            btn.classList.remove('selected');
          }
        }
      }

      var statusBadge = document.getElementById('qBadgeStatus_' + questionId);
      if (statusBadge) {
        statusBadge.className = 'badge badge-emerald';
        statusBadge.textContent = 'Sudah Dipilih (1 Guru)';
      }

      var stepPill = document.getElementById('stepPill_' + questionId);
      if (stepPill) {
        stepPill.classList.add('answered');
        var checkSpan = stepPill.querySelector('.step-pill-check');
        if (checkSpan) checkSpan.innerHTML = '&#10003;';
      }

      updateVoterProgressCounters();
    }

    function updateVoterProgressCounters() {
      var questions = appState.voterBallot.questions || [];
      var total = questions.length;
      var answered = 0;
      for (var i = 0; i < total; i++) {
        if (appState.voterBallot.selectedByQuestion[questions[i].id]) {
          answered++;
        }
      }

      var curIdx = parseInt(appState.voterBallot.currentQuestionIndex, 10) || 0;
      var isLastQuestion = (total > 0 && curIdx >= total - 1);
      var isAllAnswered = (total > 0 && answered >= total);

      document.getElementById('voterProgressValue').textContent = answered + ' / ' + total;
      document.getElementById('stickyProgressText').textContent = 'Soal ' + (curIdx + 1) + ' dari ' + total + '  •  Terjawab ' + answered + ' / ' + total;

      var subEl = document.getElementById('stickyPageSubtext');
      if (subEl && total > 0) {
        subEl.textContent = isAllAnswered
          ? 'Seluruh ' + total + ' pertanyaan telah dijawab. Silakan klik Kirim Pilihan Saya.'
          : 'Pilih 1 kandidat guru pada setiap soal lalu klik Berikutnya.';
      }

      var btnPrev = document.getElementById('btnStickyPrevQuestion');
      if (btnPrev) {
        btnPrev.disabled = (curIdx <= 0);
      }

      var btnNext = document.getElementById('btnStickyNextQuestion');
      if (btnNext) {
        if (isLastQuestion) {
          btnNext.classList.add('hidden');
        } else {
          btnNext.classList.remove('hidden');
          btnNext.disabled = false;
        }
      }

      var btnSubmit = document.getElementById('btnOpenSubmitConfirm');
      if (btnSubmit) {
        if (isLastQuestion || isAllAnswered) {
          btnSubmit.classList.remove('hidden');
        } else {
          btnSubmit.classList.add('hidden');
        }
      }
    }

    function handleConfirmSubmitBallot() {
      var questions = appState.voterBallot.questions || [];
      var selectedMap = appState.voterBallot.selectedByQuestion || {};

      for (var i = 0; i < questions.length; i++) {
        var q = questions[i];
        if (!selectedMap[q.id]) {
          showToast('Pertanyaan ' + (i + 1) + ' (' + q.kategori + ') belum dipilih. Mohon pilih 1 guru untuk setiap pertanyaan.', 'error');
          gotoBallotQuestion(i);
          return;
        }
      }

      openConfirmModal(
        'Kirim Suara Pemilihan Guru Teladan?',
        'Apakah Anda yakin dengan pilihan Anda pada seluruh ' + questions.length + ' kategori pertanyaan? Setelah dikirim, suara bersifat final dan tidak dapat diubah lagi.',
        function() {
          executeSubmitBallot();
        },
        'Ya, Kirim Suara Saya'
      );
    }

    function executeSubmitBallot() {
      var questions = appState.voterBallot.questions || [];
      var selectedMap = appState.voterBallot.selectedByQuestion || {};
      var answers = [];

      for (var i = 0; i < questions.length; i++) {
        var qid = questions[i].id;
        answers.push({
          questionId: qid,
          candidateId: selectedMap[qid]
        });
      }

      var payload = {
        voterId: appState.currentUser.id,
        answers: answers
      };

      var submitBtn = document.getElementById('btnOpenSubmitConfirm');
      callBackend('submitVoterBallot', payload, function(res) {
        if (!res || !res.success) {
          showToast((res && res.message) ? res.message : 'Gagal mengirim suara.', 'error');
          return;
        }

        // Optimistic UI update: langsung tandai Sudah Memilih
        appState.currentUser.statusPilih = 'Sudah Memilih';
        appState.currentUser.waktuPilih = res.waktuPilih || 'Baru saja';
        saveActiveUserSession();
        renderVoterBallotScreen();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        showToast(res.message, 'success');
      }, null, submitBtn);
    }

