      <form id="apiConfigForm" onsubmit="event.preventDefault(); handleSaveGasApiUrl();">
        <div class="modal-body">
          <p style="font-size: 0.82rem; color: var(--slate-600); margin-bottom: 12px; line-height: 1.5;">
            Masukkan <strong>URL Aplikasi Web (Web App URL)</strong> dari Google Apps Script Anda yang berakhiran <code>/exec</code> agar website Vercel ini terhubung ke database Google Sheets &amp; Google Drive sekolah.
          </p>
          <div class="form-group" style="margin-bottom: 8px;">
            <label class="form-label" for="inputGasApiUrl">URL Web App Google Apps Script (<code>.../exec</code>)</label>
            <input type="url" id="inputGasApiUrl" class="form-control" placeholder="https://script.google.com/macros/s/AKfycb.../exec" required />
          </div>
          <div style="font-size: 0.74rem; color: var(--slate-500); line-height: 1.45;">
            Tips: Agar seluruh guru tidak perlu memasukkan URL ini di HP masing-masing, tempelkan juga URL <code>/exec</code> Anda pada variabel <code>DEFAULT_GAS_WEB_APP_URL</code> di dalam berkas <code>index.html</code> di GitHub.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-action="close-api-config-modal">Batal</button>
          <button type="submit" class="btn btn-primary">Simpan &amp; Hubungkan</button>
        </div>
      </form>
    </div>
  </div>
  <script>
    /**
     * ========================================================================
     * KONFIGURASI URL API GOOGLE APPS SCRIPT (UNTUK VERCEL / GITHUB)
     * ========================================================================
     * Tempelkan URL Web App Google Apps Script Anda (yang berakhiran /exec)
     * di dalam tanda kutip DEFAULT_GAS_WEB_APP_URL di bawah ini:
     */
    var DEFAULT_GAS_WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbwEc3Kjrfowrdli7PuPLWiH09afyiUFSbgcwHVj9Ovvoe96EfKWthWCoDUeEnIecLCD/exec';
    var GAS_API_URL_STORAGE_KEY = 'sipegut_gas_api_url_v19';

    function getActiveGasApiUrl() {
      var fromDefault = String(DEFAULT_GAS_WEB_APP_URL || '').trim();
      if (fromDefault && fromDefault.indexOf('https://script.google.com/') === 0) {
        return fromDefault;
      }
      try {
        var params = new URLSearchParams(window.location.search);
        var fromQuery = String(params.get('api') || '').trim();
        if (fromQuery && fromQuery.indexOf('https://script.google.com/') === 0) {
          localStorage.setItem(GAS_API_URL_STORAGE_KEY, fromQuery);
          return fromQuery;
        }
        var fromStorage = String(localStorage.getItem(GAS_API_URL_STORAGE_KEY) || '').trim();
        if (fromStorage && fromStorage.indexOf('https://script.google.com/') === 0) {
          return fromStorage;
        }
      } catch (e) {}
      return '';
    }

    function openApiConfigModal() {
      var inputEl = document.getElementById('inputGasApiUrl');
      if (inputEl) {
        inputEl.value = getActiveGasApiUrl();
      }
      document.getElementById('apiConfigModal').classList.remove('hidden');
    }

    function closeApiConfigModal() {
      document.getElementById('apiConfigModal').classList.add('hidden');
    }

    function handleSaveGasApiUrl() {
      var inputEl = document.getElementById('inputGasApiUrl');
      var rawUrl = inputEl ? String(inputEl.value || '').trim() : '';
      if (!rawUrl || rawUrl.indexOf('https://script.google.com/') !== 0) {
        showToast('Mohon masukkan URL Web App Google Apps Script yang valid (diawali https://script.google.com/...).', 'error');
        return;
      }
      try {
        localStorage.setItem(GAS_API_URL_STORAGE_KEY, rawUrl);
      } catch (e) {}
      closeApiConfigModal();
      updateExternalApiSetupBarVisibility();
      showToast('URL Server berhasil disimpan! Menyinkronkan data sekolah...', 'success');
      loadInitialPublicConfig();
    }
    /**
     * ========================================================================
     * STATE & CLIENT-SIDE IN-MEMORY CACHE (0s MENU SWITCHING & OPTIMISTIC UI)
     * ========================================================================
     */
    var appState = {
      currentUser: null,
      activeAdminTab: 'dashboard',
      settings: {
        NAMA_SEKOLAH: 'UPTD SDN 6 WAY RATAI',
        PERIODE_PEMILIHAN: 'Tahun Ajaran 2026/2027',
        STATUS_PEMILIHAN: 'BUKA',
        KEPALA_SEKOLAH: 'KABUL, S.Pd.SD',
        NIP_KEPSEK: '19680208 199308 1 001',
        KETUA_PANITIA: 'MASNAH, S.Pd.SD',
        NIP_KETUA_PANITIA: '19670623 199103 2 006',
        LOGO_SEKOLAH: '',
        LOGO_SEKOLAH_URL: ''
      },
      voterBallot: {
        questions: [],
        candidates: [],
        selectedByQuestion: {},
        currentQuestionIndex: 0
      },
      userFilter: {
        search: '',
        role: 'ALL',
        statusPilih: 'ALL',
        page: 1,
        pageSize: 10
      },
      questionFilter: {
        search: '',
        status: 'ALL',
        page: 1,
        pageSize: 10
      },
      confirmCallback: null
    };

    // In-Memory Cache Object
    var appCache = {
      dashboard: null,
      usersPages: {},
      usersById: {},
      questionsPages: {},
      questionsById: {}
    };

    function invalidateCache(scopes) {
      if (!scopes || scopes.indexOf('ALL') !== -1) {
        appCache.dashboard = null;
        appCache.usersPages = {};
        appCache.questionsPages = {};
        return;
      }
      for (var i = 0; i < scopes.length; i++) {
        var s = scopes[i];
        if (s === 'dashboard') appCache.dashboard = null;
        if (s === 'users') appCache.usersPages = {};
        if (s === 'questions') appCache.questionsPages = {};
      }
    }

    /**
     * Helper Escaping String HTML (Anti-XSS & Anti-Kutipan Pecah)
     */
    function escapeHtml(str) {
      if (str === null || typeof str === 'undefined') return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    /**
     * Mengambil 2 huruf inisial nama guru untuk avatar fallback
     */
    function getInitials(nama) {
      var clean = String(nama || 'GR').replace(/[^a-zA-Z\s]/g, ' ').trim();
      var parts = clean.split(/\s+/);
      if (parts.length >= 2) {
        return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
      }
      return clean.substring(0, 2).toUpperCase() || 'GR';
    }

    /**
     * Konversi instan link Google Drive di sisi klien untuk live preview
     */
    function normalizeClientDriveUrl(rawInput) {
      var str = String(rawInput || '').trim();
      if (!str) return '';
      if (str.indexOf('data:image/') === 0) return str;

      var fileId = '';
      var matchD = str.match(/\/d\/([a-zA-Z0-9_-]{15,})/);
      if (matchD && matchD[1]) fileId = matchD[1];

      if (!fileId) {
        var matchId = str.match(/[?&]id=([a-zA-Z0-9_-]{15,})/);
        if (matchId && matchId[1]) fileId = matchId[1];
      }

      if (!fileId && str.indexOf('http') !== 0 && /^[a-zA-Z0-9_-]{20,}$/.test(str)) {
        fileId = str;
      }

      if (fileId) {
        return 'https://drive.google.com/thumbnail?id=' + fileId + '&sz=w400';
      }
      return str;
    }

    /**
     * Merender Avatar Foto Guru (Google Drive) dengan fallback inisial otomatis jika foto kosong/gagal muat
     */
    function renderTeacherAvatarHtml(nama, fotoUrl, sizePx) {
      var sz = sizePx || 42;
      var fontSz = Math.max(11, Math.round(sz * 0.36));
      var initials = escapeHtml(getInitials(nama));
      var resolvedUrl = normalizeClientDriveUrl(fotoUrl);

      if (!resolvedUrl) {
        return '<span class="teacher-avatar-wrap" style="width:' + sz + 'px; height:' + sz + 'px; font-size:' + fontSz + 'px;">' + initials + '</span>';
      }

      return (
        '<span class="teacher-avatar-wrap" style="width:' + sz + 'px; height:' + sz + 'px; font-size:' + fontSz + 'px;">' +
          '<img src="' + escapeHtml(resolvedUrl) + '" alt="' + escapeHtml(nama) + '" class="teacher-avatar-img" loading="lazy" ' +
            'onerror="this.style.display=\'none\'; this.parentNode.textContent=\'' + initials + '\';" />' +
        '</span>'
      );
    }

    /**
     * Toast Notification Kustom
     */
    function showToast(message, type) {
      var container = document.getElementById('toastContainer');
      if (!container) return;

      var toast = document.createElement('div');
      var kindClass = type === 'error' ? 'toast-error' : (type === 'success' ? 'toast-success' : '');
      toast.className = 'toast-item ' + kindClass;
      toast.innerHTML = '<span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);

      setTimeout(function() {
        if (toast && toast.parentNode) {
          toast.parentNode.removeChild(toast);
        }
      }, 4200);
    }

    /**
     * Modal Konfirmasi Kustom
     */
    function openConfirmModal(title, message, onConfirm, btnLabel) {
      document.getElementById('confirmModalTitle').textContent = title || 'Konfirmasi';
      document.getElementById('confirmModalMessage').textContent = message || '';
      var btn = document.getElementById('btnConfirmProceed');
      btn.textContent = btnLabel || 'Ya, Lanjutkan';
      appState.confirmCallback = onConfirm;
      document.getElementById('confirmModal').classList.remove('hidden');
    }

    function closeConfirmModal() {
      document.getElementById('confirmModal').classList.add('hidden');
      appState.confirmCallback = null;
    }

    /**
     * ========================================================================
     * KOMUNIKASI BACKEND DUAL-MODE (GOOGLE APPS SCRIPT NATIVE & VERCEL FETCH API)
     * ========================================================================
     */
    function callBackend(fnName, payload, onSuccess, onFailure, btnEl) {
      var originalHtml = '';
      if (btnEl) {
        btnEl.disabled = true;
        originalHtml = btnEl.innerHTML;
        btnEl.innerHTML = '<span>Memproses...</span>';
      }

      function restoreBtn() {
        if (btnEl) {
          btnEl.disabled = false;
          btnEl.innerHTML = originalHtml;
        }
      }

      // Mode 1: Berjalan langsung di dalam Google Apps Script Web App
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        var runner = google.script.run
          .withSuccessHandler(function(res) {
            restoreBtn();
            if (onSuccess) onSuccess(res);
          })
          .withFailureHandler(function(err) {
            restoreBtn();
            var errMsg = (err && err.message) ? err.message : 'Terjadi gangguan komunikasi dengan server Google Apps Script.';
            showToast(errMsg, 'error');
            if (onFailure) onFailure(err);
          });

        if (typeof payload !== 'undefined' && payload !== null) {
          runner[fnName](payload);
        } else {
          runner[fnName]();
        }
        return;
      }

      // Mode 2: Berjalan di Vercel / GitHub Pages (Menggunakan HTTPS Fetch API bebas CORS Preflight)
      var apiUrl = getActiveGasApiUrl();
      if (apiUrl) {
        fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8'
          },
          body: JSON.stringify({
            action: fnName,
            payload: typeof payload !== 'undefined' ? payload : null
          }),
          redirect: 'follow'
        })
          .then(function(response) {
            if (!response.ok) {
              throw new Error('HTTP ' + response.status);
            }
            return response.json();
          })
          .then(function(res) {
            restoreBtn();
            if (onSuccess) onSuccess(res);
          })
          .catch(function(err) {
            restoreBtn();
            if (fnName !== 'getPublicAppConfig') {
              showToast('Gagal terhubung ke Server Google Apps Script: ' + (err && err.message ? err.message : 'Periksa URL /exec Anda.'), 'error');
            }
            if (onFailure) onFailure(err);
          });
        return;
      }

      // Jika dibuka di Vercel namun URL Web App Google Apps Script belum diatur
      restoreBtn();
      if (fnName !== 'getPublicAppConfig') {
        openApiConfigModal();
      }
      if (onFailure) onFailure({ message: 'GAS API URL belum diatur' });
    }

    /**
     * ========================================================================
     * INISIALISASI HALAMAN & PENGATURAN PUBLIK
     * ========================================================================
     */
    var SESSION_STORAGE_KEY = 'sipegut_active_session_v14';
    var SESSION_TTL_MS = 20 * 60 * 1000; // Sesi bertahan 20 menit saat refresh halaman

    function saveActiveUserSession() {
      try {
        if (!appState.currentUser || !appState.currentUser.id) return;
        var sessionPayload = {
          user: appState.currentUser,
          activeAdminTab: appState.activeAdminTab || 'dashboard',
          voterBallot: {
            questions: appState.voterBallot.questions || [],
            candidates: appState.voterBallot.candidates || [],
            selectedByQuestion: appState.voterBallot.selectedByQuestion || {},
            currentQuestionIndex: appState.voterBallot.currentQuestionIndex || 0
          },
          expiresAt: new Date().getTime() + SESSION_TTL_MS
        };
        localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(sessionPayload));
      } catch (e) {}
    }

    function clearActiveUserSession() {
      try {
        localStorage.removeItem(SESSION_STORAGE_KEY);
      } catch (e) {}
    }

    function tryRestoreActiveUserSession() {
      try {
        var raw = localStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw) return false;
        var sess = JSON.parse(raw);
        if (!sess || !sess.user || !sess.user.id || !sess.expiresAt) {
          clearActiveUserSession();
          return false;
        }
        if (new Date().getTime() >= sess.expiresAt) {
          clearActiveUserSession();
          document.getElementById('loginView').classList.remove('hidden');
          return false;
        }

        // Perpanjang masa aktif sesi 20 menit ke depan karena halaman baru di-refresh
        appState.currentUser = sess.user;
        appState.activeAdminTab = sess.activeAdminTab || 'dashboard';
        if (sess.voterBallot) {
          appState.voterBallot.questions = sess.voterBallot.questions || [];
          appState.voterBallot.candidates = sess.voterBallot.candidates || [];
          appState.voterBallot.selectedByQuestion = sess.voterBallot.selectedByQuestion || {};
          appState.voterBallot.currentQuestionIndex = sess.voterBallot.currentQuestionIndex || 0;
        }
        saveActiveUserSession();

        if (appState.currentUser.peran === 'Admin') {
          enterAdminView(appState.activeAdminTab);
        } else {
          enterVoterView({
            questions: appState.voterBallot.questions,
            candidates: appState.voterBallot.candidates,
            preserveSelections: true
          });
          // Sinkronkan status terbaru di latar belakang tanpa menghapus pilihan yang sedang diisi
          callBackend('getVoterBallotData', appState.currentUser.id, function(res) {
            if (res && res.success && appState.currentUser) {
              appState.currentUser = res.user;
              if (res.settings) {
                appState.settings = res.settings;
                saveSettingsToLocalCache(appState.settings);
              }
              if (res.ballotBundle) {
                appState.voterBallot.questions = res.ballotBundle.questions || [];
                appState.voterBallot.candidates = res.ballotBundle.candidates || [];
              }
              saveActiveUserSession();
              renderVoterBallotScreen();
            }
          });
        }
        return true;
      } catch (e) {
        clearActiveUserSession();
        document.getElementById('loginView').classList.remove('hidden');
        return false;
      }
    }

    window.addEventListener('DOMContentLoaded', function() {
      updateExternalApiSetupBarVisibility();
      loadInitialPublicConfig();
      setupGlobalEventDelegation();
      tryRestoreActiveUserSession();
    });

    function updateExternalApiSetupBarVisibility() {
      var barEl = document.getElementById('externalApiSetupBar');
      var lblEl = document.getElementById('externalApiStatusLabel');
      if (!barEl) return;
      var isInsideGas = (typeof google !== 'undefined' && google.script && google.script.run);
      if (isInsideGas) {
        barEl.classList.add('hidden');
        return;
      }
      var hasHardcodedDefault = Boolean(String(DEFAULT_GAS_WEB_APP_URL || '').trim());
      if (hasHardcodedDefault) {
        barEl.classList.add('hidden');
        return;
      }
      barEl.classList.remove('hidden');
      if (lblEl) {
        lblEl.textContent = getActiveGasApiUrl()
          ? 'Server Apps Script: Terhubung'
          : 'Server Apps Script: Belum Diatur';
      }
    }

    function saveSettingsToLocalCache(settingsObj) {
      if (!settingsObj) return;
      try {
        localStorage.setItem('sipegut_settings_v13', JSON.stringify(settingsObj));
      } catch (e) {}
    }

    function loadInitialPublicConfig() {
      // 1. Gunakan data SSR dari server (window.__INITIAL_SETTINGS__) atau localStorage secara instan (0.00 detik)
      if (window.__INITIAL_SETTINGS__ && window.__INITIAL_SETTINGS__.NAMA_SEKOLAH) {
        appState.settings = window.__INITIAL_SETTINGS__;
        saveSettingsToLocalCache(appState.settings);
        renderLoginHeaderInfo();
        return;
      }

      try {
        var cachedStr = localStorage.getItem('sipegut_settings_v13');
        if (cachedStr) {
          var parsed = JSON.parse(cachedStr);
          if (parsed && parsed.NAMA_SEKOLAH) {
            appState.settings = parsed;
            renderLoginHeaderInfo();
          }
        }
      } catch (e) {}

      // 2. Sinkronisasi latar belakang jika belum ada SSR
      callBackend('getPublicAppConfig', null, function(res) {
        if (res && res.success && res.settings) {
          appState.settings = res.settings;
          saveSettingsToLocalCache(appState.settings);
          renderLoginHeaderInfo();
        }
      });
    }

    /**
     * Merender Logo Sekolah pada Kotak Seal Halaman Login & Ikon Navbar (Fallback ke Ikon Bintang jika kosong/gagal)
     */
    function getStarSealSvgHtml(sizePx) {
      var sz = sizePx || 30;
      return (
        '<svg width="' + sz + '" height="' + sz + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>' +
        '</svg>'
      );
    }

    function applyLogoToSealElement(el, rawLogoOrUrl, fallbackSvgHtml) {
      if (!el) return;
      var resolved = normalizeClientDriveUrl(rawLogoOrUrl);
      if (!resolved) {
        el.classList.remove('has-logo');
        el.innerHTML = fallbackSvgHtml;
        return;
      }

      // Hindari pembuatan ulang DOM <img> jika src sudah sama persis (Anti-Flicker)
      var currentImg = el.querySelector('img');
      if (currentImg && currentImg.getAttribute('src') === resolved) {
        el.classList.add('has-logo');
        return;
      }

      el.classList.add('has-logo');
      el.innerHTML = '';
      var img = document.createElement('img');
      img.src = resolved;
      img.alt = 'Logo Sekolah';
      img.decoding = 'sync';
      img.style.width = '100%';
      img.style.height = '100%';
      img.style.objectFit = 'contain';
      img.onerror = function() {
        el.classList.remove('has-logo');
        el.innerHTML = fallbackSvgHtml;
      };
      el.appendChild(img);
    }

